# RocketRide engine connection used by the /api/verify route.
# Local dev: the VS Code extension runs the engine on a DYNAMIC localhost port
# (it launches with --port=0), so detect it and set the URI, e.g.:
#   ROCKETRIDE_URI=ws://localhost:50128
# The local embedded engine does not enforce auth — any value works.
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=local

# Optional: a GitHub token for the "verify a PR" feature. Public PRs work without it
# (rate-limited 60/hr); set one to lift the limit or read private repos.
# GITHUB_TOKEN=ghp_xxx
