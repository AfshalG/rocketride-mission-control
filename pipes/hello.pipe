{
  "name": "Hello RocketRide",
  "description": "Smallest possible pipe: chat in, Gemini answers, response out.",
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "name": "Chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      },
      "ui": {
        "position": {
          "x": 20,
          "y": 200
        },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "agent_langchain_1",
      "provider": "agent_langchain",
      "name": "Assistant",
      "config": {
        "instructions": [
          "You are a helpful assistant. Answer the user's question clearly and concisely."
        ],
        "max_waves": 5,
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 240,
          "y": 200
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_gemini",
      "name": "Gemini",
      "config": {
        "profile": "custom",
        "custom": {
          "model": "gemini-3.1-flash-lite-preview",
          "modelTotalTokens": 1000000,
          "outputTokens": 8192,
          "apikey": "${ROCKETRIDE_GEMINI_KEY}"
        },
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 130,
          "y": 380
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_langchain_1"
        }
      ]
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "name": "Return Answers",
      "config": {
        "laneName": "answers"
      },
      "ui": {
        "position": {
          "x": 447,
          "y": 222
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "answers",
          "from": "agent_langchain_1"
        }
      ]
    }
  ],
  "source": "chat_1",
  "project_id": "hello-0000-0000-0000-000000000000",
  "version": 1,
  "docRevision": 2,
  "isLocked": false,
  "snapToGrid": true,
  "snapGridSize": [
    10,
    10
  ]
}
